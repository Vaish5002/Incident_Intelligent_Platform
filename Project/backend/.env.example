# ============================================
# SMARTOPS AI - BACKEND CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# Location: Project/backend/.env

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8002
DEBUG=True

# ============================================
# GROQ AI CONFIGURATION (REQUIRED)
# ============================================
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# GITHUB AGENT CONFIGURATION (OPTIONAL)
# ============================================
# GitHub Personal Access Token for higher rate limits
# Without token: 60 requests/hour (anonymous)
# With token: 5000 requests/hour (authenticated)
# Get token from: https://github.com/settings/tokens
# Select scope: public_repo (for public repositories)
GITHUB_TOKEN=

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=sqlite:///./smartops_ai.db

# ============================================
# CORS CONFIGURATION
# ============================================
# Add your frontend URLs here (comma-separated, no spaces)
# Development: http://localhost:5173
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ============================================
# EXTERNAL SERVICES (OPTIONAL)
# ============================================
# Chaos Demo Platform for Log Agent (already deployed)
PROJECT2_URL=https://chaos-demo-platform.onrender.com
CHAOS_PLATFORM_URL=https://chaos-demo-platform.onrender.com

# Investigation Backend URL (if integrating with Member 1)
INVESTIGATION_BACKEND_URL=http://localhost:8000
